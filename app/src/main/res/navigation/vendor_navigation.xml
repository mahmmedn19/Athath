<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/vendor_profile">

    <fragment
        android:id="@+id/vendor_profile"
        android:name="com.project.asas.ui.vendors_screen.profile.ProfileFragment"
        android:label="Vendor Profile" />


    <fragment
        android:id="@+id/vendor_products"
        android:name="com.project.asas.ui.vendors_screen.manage_products.ManageProductsFragment"
        android:label="Manage Products" >
        <action
            android:id="@+id/action_vendor_products_to_add_product"
            app:destination="@id/add_product" />
    </fragment>

    <fragment
        android:id="@+id/add_product"
        android:name="com.project.asas.ui.vendors_screen.add_product_screen.AddProductFragment"
        android:label="Add Product"/>

</navigation>
