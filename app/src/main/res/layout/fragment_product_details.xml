<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_theme_background"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/llProductDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Product Image Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="300dp">

                    <ImageView
                        android:id="@+id/ivProductImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="16dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Product Image"
                        android:src="@drawable/furniture_3" />

                    <ImageView
                        android:id="@+id/ivFavoriteIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:background="@drawable/circle_background"
                        android:padding="8dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- Product Details -->
                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Modern Chair"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRoomType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Living Room"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  •  Modern"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="White"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="$100"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDimensions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="55 x 60 cm"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Description"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescriptionDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
                    android:textColor="@color/md_theme_secondary"
                    android:textSize="14sp" />

                <!-- Store Information -->
                <TextView
                    android:id="@+id/tvStoreInformation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Store Information"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStoreName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Store Name"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvStoreAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="123 Main St, Springfield"
                    android:textColor="@color/md_theme_secondary"
                    android:textSize="14sp" />

                <!-- Suggestions -->
                <TextView
                    android:id="@+id/tvSuggestionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Suggestions"
                    android:textColor="@color/md_theme_primary"
                    android:textSize="20sp" />
                <ProgressBar
                    android:id="@+id/progressBarSuggestion"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:visibility="gone"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:indeterminate="true" />
                <ImageView
                    android:id="@+id/imageNoDataFoundProduct"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/image_no_data_found"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSuggestionItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="64dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/home_item" />
            </LinearLayout>
        </ScrollView>

        <!-- Full-Screen Loading Overlay -->
        <FrameLayout
            android:id="@+id/fullScreenLoader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:layout_gravity="center_vertical|center_horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical|center_horizontal"
                android:indeterminate="true" />
        </FrameLayout>
    </FrameLayout>
</layout>
