<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:background="@color/md_theme_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product Image Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <!-- Product Image -->
                <ImageView
                    android:id="@+id/ivProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/furniture_3"
                    android:scaleType="centerCrop"
                    android:contentDescription="Product Image"
                    android:layout_marginTop="16dp" />

                <!-- Favorite Icon -->
                <ImageView
                    android:id="@+id/ivFavoriteIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/circle_background"
                    android:padding="8dp"
                    android:src="@drawable/ic_favorite"
                    app:tint="@color/white"
                    android:layout_gravity="top|end" />
            </FrameLayout>

            <!-- Product Name -->
            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modern Chair"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textColor="@color/md_theme_primary" />

            <!-- Tags: Room Type, Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvRoomType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Living Room"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_secondary" />

                <TextView
                    android:id="@+id/tvStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  Modern"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_secondary" />
            </LinearLayout>

            <!-- Product Features -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="White"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_secondary"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$100"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_secondary"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/tvDimensions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="55 x 60 cm"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_secondary" />
            </LinearLayout>

            <!-- Description Section -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textColor="@color/md_theme_primary" />

            <TextView
                android:id="@+id/tvDescriptionDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:textColor="@color/md_theme_secondary" />
            <!-- Store Information -->
            <TextView
                android:id="@+id/tvStoreInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Store Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textColor="@color/md_theme_primary" />
            <!-- Store Details -->
            <TextView
                android:id="@+id/tvStoreName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Name"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:textColor="@color/md_theme_primary" />

            <TextView
                android:id="@+id/tvStoreAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123 Main St, Springfield"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:textColor="@color/md_theme_secondary" />



            <!-- Living Room Suggestion -->
            <TextView
                android:id="@+id/tvSuggestionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suggestions"
                android:textSize="20sp"
                android:layout_marginTop="24dp"
                android:textColor="@color/md_theme_primary" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestionItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:verticalSpacing="8dp"
                android:orientation="horizontal"
                tools:listitem="@layout/home_item"
                android:horizontalSpacing="8dp" />

        </LinearLayout>
    </ScrollView>
</layout>