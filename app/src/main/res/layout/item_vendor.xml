<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vendor"
            type="com.project.athath.data.model.Vendor"/>

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">


            <!-- Vendor Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/vendorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{vendor.name}"
                    tools:text="vendor.name}"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/vendorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{vendor.status}"
                    tools:text="vendor.status}"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"/>

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Accept Button -->
                <ImageButton
                    android:id="@+id/btnAccept"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_check"
                    app:backgroundTint="@color/black_transparent"
                    android:contentDescription="Accept Vendor"
                    />

                <!-- Block Button -->
                <ImageButton
                    android:id="@+id/btnBlock"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:backgroundTint="@color/black_transparent"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Block Vendor" />

                <!-- View Profile Button -->
                <ImageButton
                    android:id="@+id/btnViewProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:backgroundTint="@color/black_transparent"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="View Vendor Profile" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>
