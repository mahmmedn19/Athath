<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="component"
            type="com.project.athath.data.model.ResponseModel.DetectedObject" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_background_primary_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/componentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@{component.label}"
            android:textColor="@color/md_theme_secondary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Component Name" />

        <ImageView
            android:id="@+id/componentImage"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            tools:src="@drawable/image_3" />
    </LinearLayout>

</layout>