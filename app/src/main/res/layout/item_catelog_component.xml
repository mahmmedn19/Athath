<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="component"
            type="com.project.asas.model.Component" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_background_primary_2">
        <TextView
            android:id="@+id/componentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@{component.name}"
            tools:text="Component Name"
            android:textSize="16sp"
            android:textColor="@color/md_theme_secondary"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"/>

        <ImageView
            android:id="@+id/componentImage"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:src="@{component.imageResId}"
            android:scaleType="centerCrop"
            tools:src="@drawable/image_3" />


    </LinearLayout>

</layout>