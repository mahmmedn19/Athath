<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="item"
            type="com.project.athath.data.model.CatalogItem"
            />

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Catalog Image -->
            <ImageView
                android:id="@+id/ivCatalogImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                tools:src="@drawable/furniture_5"
                android:src="@{item.imageRes}"
                android:contentDescription="Catalog Image"/>

            <!-- Show Products Button -->
            <Button
                android:id="@+id/btnShowProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Products"
                android:textSize="16sp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="12dp"
                android:backgroundTint="@color/md_theme_primary"
                android:textColor="@color/white"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>
