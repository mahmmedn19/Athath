<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/md_theme_background"
        android:padding="16dp">

        <!-- Top Section: Profile and Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Profile Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Profile Image -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_profile"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Profile Image"
                    android:background="@drawable/circle_background" />

                <!-- Profile Name -->
                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Guest!"
                    android:textSize="16sp"
                    android:textColor="@color/black" />
            </LinearLayout>

            <!-- App Logo and About Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end"
                android:orientation="horizontal">

                <!-- App Logo -->
                <ImageView
                    android:id="@+id/appLogo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/logo"
                    android:contentDescription="App Logo" />

            </LinearLayout>
        </LinearLayout>

        <!-- Welcome Message -->
        <TextView
            android:id="@+id/welcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Welcome back!"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/md_theme_primary" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Design Your Dream Room with Ease!"
            android:textSize="16sp"
            android:textColor="@color/md_theme_secondary" />

        <!-- Main Image/Banner -->
        <ImageView
            android:id="@+id/mainBanner"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/furniture1"
            android:shadowColor="@color/md_theme_secondary"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"
            android:scaleType="centerCrop"
            android:contentDescription="Main Banner" />

        <!-- Product List Title -->
        <TextView
            android:id="@+id/productListTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Items in this Collection"
            android:textSize="18sp"
            android:textColor="@color/md_theme_primary" />

        <!-- Product List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            android:verticalSpacing="8dp"
            tools:listitem="@layout/home_item"
            android:horizontalSpacing="8dp" />
    </LinearLayout>
</layout>